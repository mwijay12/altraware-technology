# ─── NAKALA HII KWA .env.local (USIWEKE SECRETS HALISI HAPA) ───
# Jaza na u-restart `next dev` kila ukibadilisha NEXT_PUBLIC_* vars.

# ─── DOMAIN / SEO CONFIG ────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://altra.tanzaniareach.com

# ─── CLOUDINARY (unsigned upload — public values, si siri) ───
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Hii ni SIRI — server-side pekee, kamwe usiweke kwenye client code:
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ─── FIREBASE (web config) ───
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── ADMIN CONSOLE (server-side pekee — USITUMIE NEXT_PUBLIC_) ───
# Master passphrase ya /admin — lazima iwe ndefu na ya siri.
ADMIN_MASTER_KEY=

# ─── AI ENGINES (server-side pekee — USITUMIE NEXT_PUBLIC_) ───
INCEPTION_API_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=mercury-2.5
INCEPTION_REASONING_EFFORT=low
INCEPTION_API_KEY=
INCEPTION_API_KEYS=
AGNES_API_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=openai/deepseek-ai/DeepSeek-V3
AGNES_API_KEY=
AGNES_API_KEYS=

# ─── NODEMAILER / SMTP (server-side pekee — auto-reply kwa mteja & alert kwa admin) ───
# Kwa Gmail: tumia App Password ya tarakimu 16 (Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=altrawaretechnology@gmail.com
SMTP_PASS=
SMTP_FROM="Altraware Technology" <altrawaretechnology@gmail.com>
ADMIN_NOTIFICATION_EMAIL=altrawaretechnology@gmail.com
